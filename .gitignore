# Track only: src/, requirements.txt, diagram/

# Ignore everything
*

!.gitignore

# Unignore tracked paths
!src/
!src/**
!tests/
!tests/**
!requirements.txt
!models/
!models/**

# DreamSim weights are downloaded on demand (~1 GB) — never commit them.
models/dreamsim/
!diagram/
!diagram/**
!docs/
!docs/**

# Always ignore cache/compiled
src/**/__pycache__/
src/**/*.pyc
src/**/*.pyo
src/**/*.pyd

tests/**/__pycache__/
tests/**/*.pyc
tests/**/*.pyo
tests/**/*.pyd

# vscode Settings
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Claude Code settings
!.claude/
!.claude/settings.json
