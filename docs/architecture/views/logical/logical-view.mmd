classDiagram
    direction TB

    class LoadedImage {
        +raw
        +spacing
        +is_volumetric
    }

    class ImageLoader {
        +path
        +normalizer
        +raw
        +raw_range
        +intensity_range
        +tensor
        +rgb_tensor
        +spacing
        +is_volumetric
        +empty_slice_mask
        +log_tensor_shape()
    }

    class Normalizer {
        <<protocol>>
        +name
        +range_of(raw)
        +apply(raw, source)
        +empty_slices(raw)
    }

    class MinMax {
        +name
    }
    class Percentile {
        +lower
        +upper
        +name
    }
    class FixedRange {
        +range
        +name
    }
    class Mask {
        +label
        +threshold
        +name
    }
    class Raw {
        +name
    }

    Normalizer <|.. MinMax : implements
    Normalizer <|.. Percentile : implements
    Normalizer <|.. FixedRange : implements
    Normalizer <|.. Mask : implements
    Normalizer <|.. Raw : implements

    class MetricSpec {
        +name
        +direction
        +reference
        +channels
        +slice_mode
        +volume_mode
        +builtin
        +description
        +domain
    }

    class ModeSupport {
        +factory
    }
    class ModeUnsupported {
        +reason
    }

    class Metric {
        <<protocol>>
        +__call__(input, target)
    }

    class PyIQAMetric
    class DreamSimMetric
    class MonaiSegmentationMetric
    class MonaiPanopticQualityMetric
    class VolumeFunctionMetric
    class BoundaryIoUMetric
    class MonaiPSNRMetric
    class MonaiSSIMMetric

    Metric <|.. PyIQAMetric : implements
    Metric <|.. DreamSimMetric : implements
    Metric <|.. MonaiSegmentationMetric : implements
    Metric <|.. MonaiPanopticQualityMetric : implements
    Metric <|.. VolumeFunctionMetric : implements
    Metric <|.. BoundaryIoUMetric : implements
    Metric <|.. MonaiPSNRMetric : implements
    Metric <|.. MonaiSSIMMetric : implements

    class MetricRegistry {
        +register(specs)
        +register_metric(name, metric, direction, reference, channels, volume_factory, volume_reason)
        +get_metric(name, mode, spacing)
        +select(mode)
        +specs
        +direction
    }

    class IQAEvaluator {
        +input
        +target
        +registry
        +source_model
        +run_evaluation()
    }

    class VolumeEvaluator {
        +spacing
        +run_evaluation()
    }

    class build_evaluator {
        <<factory function>>
        +build_evaluator(input, target, registry, mode, source_model)
    }

    class ImageEvaluatorRecord {
        +image_id
        +source_model
        +mode
        +scoring
        +slice_index
        +is_empty
        +normalization
        +scale_lo
        +scale_hi
        +input_min
        +input_max
        +extra
        +to_dict()
    }

    class EvaluationResult {
        +from_records(records, registry)
        +to_frame()
        +aggregate_volumes()
        +generate_report(path)
    }

    IQAEvaluator <|-- VolumeEvaluator : extends

    ImageLoader ..> LoadedImage : creates
    ImageLoader --> Normalizer : holds

    IQAEvaluator --> ImageLoader : reads
    IQAEvaluator --> MetricRegistry : holds
    IQAEvaluator ..> ImageEvaluatorRecord : creates

    MetricRegistry --> MetricSpec : holds
    MetricRegistry ..> Metric : builds
    MetricSpec --> ModeSupport : holds
    MetricSpec --> ModeUnsupported : holds

    build_evaluator ..> IQAEvaluator : creates
    build_evaluator ..> VolumeEvaluator : creates

    EvaluationResult --> ImageEvaluatorRecord : holds
    EvaluationResult ..> MetricRegistry : reads
